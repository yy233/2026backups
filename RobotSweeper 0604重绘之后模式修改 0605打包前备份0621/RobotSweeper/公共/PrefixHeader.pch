#define Y_mainH [UIScreen mainScreen].bounds.size.height

//方法——检查您的网络设置
#define Y_NET_Reachable(_CODE) if ([self currentNetworkStatus]) {_CODE}else{[MBProgressHUD showError:@"网络异常,请检查您的网络设置!"];}
#define Y_NET_REACHABLE(_CODEA ,_CODEB) if ([self currentNetworkStatus]) {_CODEA}else{[MBProgressHUD showError:@"网络异常,请检查您的网络设置!"];_CODEB}
#define Y_CODEB

#define Y_pageSize 20
#define Y_pageSizeStr @"20"


//方法——正在加载
