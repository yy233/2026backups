//---------------------------------------------------------------------------
//typeof它返回值是一个字符串，该字符串说明运算数的类型。防止出现内存泄漏
#define Y_WEAKSELF  __weak typeof(self) weakSelf = self;
#define Y_NLG(_str)  NSLog(_str);
#define Y_MBP_SuccMessage [MBProgressHUD showSuccess:responsObject[@"message"]];
#define Y_MBP_ErrMessage   [MBProgressHUD showError:responsObject[@"message"]];
