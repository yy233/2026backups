#define S_xmlBaseUrl @"http://sweep.robotleo.com:8081/file/"

//品牌和设备号
#define S_xmlQg(_typeId) [NSString stringWithFormat:@"ginkgor/update/%@/",_typeId]
#define S_xmlKw(_typeId) [NSString stringWithFormat:@"kingwer/update/%@/",_typeId]
#define S_xmlBleamn(_typeId) [NSString stringWithFormat:@"bleamn/update/%@/",_typeId]


#define S_xmlC @"ControllerUpdate.xml"  //控制板
#define S_xmlS @"NavigationUpdate.xml"  //导航版
//-____________________稳定版地址
//导航版
#define S_sweeperUpdateSlamXmlOfQg(_typeId)  [NSString stringWithFormat:@"%@%@%@",S_xmlBaseUrl,S_xmlQg(_typeId),S_xmlS]

#define S_sweeperUpdateSlamXmlOfKw(_typeId)  [NSString stringWithFormat:@"%@%@%@",S_xmlBaseUrl,S_xmlKw(_typeId),S_xmlS]
#define S_sweeperUpdateSlamXmlOfBleam(_typeId)  [NSString stringWithFormat:@"%@%@%@",S_xmlBaseUrl,S_xmlBleamn(_typeId),S_xmlS]

//控制版
#define S_sweeperUpdateCtrlXmlOfQg(_typeId)  [NSString stringWithFormat:@"%@%@%@",S_xmlBaseUrl,S_xmlQg(_typeId),S_xmlC]
#define S_sweeperUpdateCtrlXmlOfKw(_typeId) [NSString stringWithFormat:@"%@%@%@",S_xmlBaseUrl,S_xmlKw(_typeId),S_xmlC]
#define S_sweeperUpdateCtrlXmlOfBleam(_typeId) [NSString stringWithFormat:@"%@%@%@",S_xmlBaseUrl,S_xmlBleamn(_typeId),S_xmlC]

//-____________________非稳定版地址
//0218 deta版的xml地址拼接部分
