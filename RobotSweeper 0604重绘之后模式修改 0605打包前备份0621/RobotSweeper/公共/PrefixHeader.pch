#define Y_MBP_Success  [MBProgressHUD showSuccess:@"加载成功"];
#define Y_MBP_Save_Error    [MBProgressHUD showError:@"保存失败"];
#define Y_MBP_Save_Success  [MBProgressHUD showSuccess:@"保存成功"];
#define Y_MBP_Message  [MBProgressHUD showMessage:@"加载中"];
#define Y_MBP_Hide     [MBProgressHUD hideHUD];

