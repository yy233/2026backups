//导航版
#define S_sweeperUpdateSlamXmlOfQgT(_typeId)  [NSString stringWithFormat:@"%@%@%@",S_xmlBaseUrl,S_xmlQg(_typeId),S_xmlST]

#define S_sweeperUpdateSlamXmlOfKwT(_typeId)  [NSString stringWithFormat:@"%@%@%@",S_xmlBaseUrl,S_xmlKw(_typeId),S_xmlST]
#define S_sweeperUpdateSlamXmlOfBleamT(_typeId)  [NSString stringWithFormat:@"%@%@%@",S_xmlBaseUrl,S_xmlBleamn(_typeId),S_xmlST]

//控制版
#define S_sweeperUpdateCtrlXmlOfQgT(_typeId)  [NSString stringWithFormat:@"%@%@%@",S_xmlBaseUrl,S_xmlQg(_typeId),S_xmlCT]
#define S_sweeperUpdateCtrlXmlOfKwT(_typeId) [NSString stringWithFormat:@"%@%@%@",S_xmlBaseUrl,S_xmlKw(_typeId),S_xmlCT]
#define S_sweeperUpdateCtrlXmlOfBleamT(_typeId) [NSString stringWithFormat:@"%@%@%@",S_xmlBaseUrl,S_xmlBleamn(_typeId),S_xmlCT]

